NODE_ENV=development
PORT=3002
# Set DATABASE_URL or the PG* fields. Never point test commands at production.
DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:5432/aatman
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=aatman
PGUSER=postgres
PGPASSWORD=
JWT_SECRET=
FACILITY_TIMEZONE=Asia/Kolkata
SLOT_INTERVAL_MINUTES=30
HOLD_MINUTES=10
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
ADMIN_NAME=Facility Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
SEED_DEMO=false
POOL_CAPACITY=20
GYM_CAPACITY=30
# Mock is development only. Use razorpay in production.
PAYMENT_PROVIDER=mock
MOCK_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
TEST_DATABASE_URL=
# Optional preserved legacy Basic Auth and OTP integration:
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
