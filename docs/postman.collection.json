    {
      "name": "Bookings",
      "item": [
        {
          "name": "Create booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/bookings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer\": {\n    \"name\": \"Rohan Kulkarni\",\n    \"phone\": \"9822041210\"\n  },\n  \"resource_id\": 1,\n  \"start_at\": \"{{start_at}}\",\n  \"end_at\": \"{{end_at}}\",\n  \"participants\": 1,\n  \"booking_source\": \"DESK\",\n  \"payment_option\": \"PAY_AT_DESK\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"booking_id\", pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List bookings",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/bookings?date={{date}}&page=1&limit=25&sort=start_at&sort_order=asc"
