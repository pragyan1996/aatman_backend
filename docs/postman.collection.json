            "url": "{{base_url}}/api/v1/auth/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Reception\",\n  \"email\": \"reception@example.com\",\n  \"password\": \"{{staff_password}}\",\n  \"role\": \"STAFF\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Update staff",
          "request": {
            "method": "PATCH",
            "header": [
