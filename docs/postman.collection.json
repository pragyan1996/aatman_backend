              "mode": "raw",
              "raw": "{\n  \"booking_id\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Mock captured callback",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Mock-Event-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "X-Mock-Signature",
                "value": "{{webhook_signature}}"
              }
            ],
            "url": "{{base_url}}/api/v1/webhooks/payments",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"payment.captured\",\n  \"payload\": {\n    \"payment\": {\n      \"entity\": {\n        \"id\": \"mock_payment_1\",\n        \"order_id\": \"{{provider_order_id}}\",\n        \"amount\": 40000,\n        \"currency\": \"INR\"\n      }\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Calculate HMAC-SHA256 of the exact raw body using MOCK_WEBHOOK_SECRET. Supply the hex signature as webhook_signature. Never enable mock in production."
          },
          "response": []
        }
      ]
    }
  ]
