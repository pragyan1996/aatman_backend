{
  "info": {
    "name": "Sports Facility Booking API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Staff JWT API. Set email/password locally. Login stores token. Select future dates within facility hours. See docs/api.md for all filters, lifecycle rules, signed callback setup and legacy API."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3002",
      "type": "string"
    },
    {
      "key": "email",
      "value": "",
      "type": "string"
    },
    {
      "key": "password",
      "value": "",
      "type": "string"
    },
    {
      "key": "staff_password",
      "value": "",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "date",
      "value": "2026-12-24",
      "type": "string"
    },
    {
      "key": "start_at",
      "value": "2026-12-24T00:30:00Z",
      "type": "string"
    },
    {
      "key": "end_at",
      "value": "2026-12-24T01:30:00Z",
      "type": "string"
    },
    {
      "key": "reschedule_start",
      "value": "2026-12-25T00:30:00Z",
      "type": "string"
    },
    {
      "key": "reschedule_end",
      "value": "2026-12-25T01:30:00Z",
      "type": "string"
    },
    {
      "key": "booking_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "customer_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "resource_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "sport_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "2",
      "type": "string"
    },
    {
      "key": "provider_order_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "webhook_signature",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Operations",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/health",
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) pm.collectionVariables.set(\"token\", pm.response.json().data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/auth/me"
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/api/v1/auth/logout"
          },
          "response": []
        },
        {
          "name": "List staff",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/auth/users"
          },
          "response": []
        },
        {
          "name": "Create staff",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
